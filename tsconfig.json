{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "experiments/compaction/**/*.ts", "scripts/evaluate-compaction.ts", "scripts/replay-compaction.ts", "scripts/benchmark-compaction.ts", "scripts/explore-compaction.ts"]
}
