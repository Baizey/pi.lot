{
  "name": "pilot",
  "version": "2.0.0",
  "description": "pi.lot: kernel-mediated filesystem and network policy for Pi's Bash tool.",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/pilot-extension.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build:native": "node ./scripts/build-native.mjs",
    "test:native": "node ./scripts/test-native.mjs",
    "test:native:host": "node ./scripts/test-native.mjs --host",
    "test:native:rust": "cargo test --locked --manifest-path native/rust/Cargo.toml",
    "test:native:integration": "node ./scripts/test-native.mjs",
    "test:native:integration:host": "node ./scripts/test-native.mjs --host",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:native && npm run typecheck",
    "install": "npm run build:native",
    "test:network": "npm run build:native && node --import jiti/register --test ./test/bash-sandbox.test.ts ./test/client-trust.test.ts ./test/host-credential-ipc-config.test.ts ./test/host-credential-ipc.test.ts ./test/network-inspection-command.test.ts ./test/network-policy-authorizer.test.ts ./test/network-policy-logic.test.ts ./test/network-policy.test.ts ./test/network-sandbox-lifecycle.test.ts ./test/network.test.ts",
    "test:runtime": "node ./scripts/test-runtime.mjs",
    "test": "npm run build && npm run test:native -- --no-build && npm run test:runtime"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "@types/node-forge": "1.3.14",
    "jiti": "2.7.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "node-forge": "1.4.0"
  }
}
