{
  "name": "pilot",
  "version": "1.0.0",
  "description": "pi.lot: kernel-mediated filesystem and network policy for Pi's Bash tool.",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/pilot-extension.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build:native": "node ./scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run build:native && npm run typecheck",
    "install": "npm run build:native",
    "test:network": "npm run build:native && node --import jiti/register --test ./test/bash-sandbox.test.ts ./test/network-policy-authorizer.test.ts ./test/network-policy-logic.test.ts ./test/network-policy.test.ts ./test/network.test.ts",
    "test:runtime": "node --import jiti/register --test ./test/bash-sandbox.test.ts ./test/extension.test.ts ./test/fuse.test.ts ./test/mcp-client.test.ts ./test/mcp-commands.test.ts ./test/mcp-config.test.ts ./test/mcp-extension.test.ts ./test/mcp-tools.test.ts ./test/network-policy-authorizer.test.ts ./test/network-policy-logic.test.ts ./test/network-policy.test.ts ./test/network.test.ts ./test/path-policy.test.ts ./test/policy-defaults-command.test.ts ./test/policy-defaults-store.test.ts ./test/terminal-text.test.ts ./test/tool-rendering.test.ts ./test/ui-decision-flow.test.ts",
    "test": "npm run build && npm run test:runtime"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/node-forge": "1.3.14",
    "jiti": "2.7.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "13.0.3",
    "fs-xattr": "0.4.0",
    "fuse-native": "2.2.6",
    "node-forge": "1.4.0",
    "zod": "4.4.3"
  }
}
